generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEADER
  MEMBER
}

enum DepartmentScope {
  LEADER
  CONTENT
  CONTENT_DESIGN
  CONTENT_EDIT
  MEDIA_DESIGN
  MEDIA_VIDEO
  WEB_ADS
  SUPPORT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum ProjectMemberScope {
  PROJECT_WIDE
  ASSIGNED_ONLY
}

enum TaskType {
  CONTENT_SOCIAL
  CONTENT_ADS
  CONTENT_WEB
  MEDIA_IMAGE
  MEDIA_VIDEO
  WEB_SEO
  ADS_CAMPAIGN
  SEEDING_SUPPORT
  OTHER
}

enum TaskStatus {
  DRAFT
  BRIEF_REVIEW
  IN_PROGRESS
  WAITING_APPROVAL
  REVISION_NEEDED
  APPROVED_FINAL
  PUBLISHED
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AssetKind {
  BRIEF_REF
  DEMO
  FINAL
  PUBLISHED_LINK
}

enum CheckinStatus {
  ON_TRACK
  AT_RISK
  DONE_TODAY
}

enum NotificationType {
  TASK_ASSIGNED
  REVIEW_REQUESTED
  REVISION_REQUESTED
  APPROVED
  AT_RISK_ALERT
  REMINDER
  CHAT_MESSAGE
  TIMELINE_UPDATE
  EXTERNAL_INTAKE
  FANPAGE_REPORT
  LEAVE_REQUEST
  MEETING_INVITE
  BIRTHDAY
  SYSTEM
}

enum TimelineStatus {
  SYNCED
  PENDING_LEADER
  APPROVED
  REJECTED
}

enum ActivityEntityType {
  TASK
  PROJECT
  BUDGET
  RESOURCE
  LEAVE
  EQUIPMENT_BOOKING
  FANPAGE
}

enum ActivityAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  TIMELINE_PROPOSE
  TIMELINE_APPROVE
  TIMELINE_REJECT
  SOFT_DELETE
  RESTORE
  PERMANENT_DELETE
}

enum LeaveType {
  FULL_DAY
  HALF_MORNING
  HALF_AFTERNOON
  REMOTE
  BUSINESS_TRIP
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EquipmentCategory {
  CAMERA
  PHONE
  CAMCORDER
  MIC_LIGHT
  OTHER
}

enum EquipmentCondition {
  AVAILABLE
  MAINTENANCE
}

enum BookingStatus {
  BOOKED
  RETURNED
  CANCELLED
}

enum ResourceScope {
  GLOBAL
  PROJECT
}

enum ResourceCategory {
  LOGO_BRAND
  PARTNER_WORK
  PHOTO_FOLDER
  SOURCE_RAW
  FINISHED_MEDIA
  GUIDELINE_DOC
  OTHER
}

enum FanpageSyncSource {
  GRAPH_API
  PUBLIC_SCRAPE
  BOOKMARKLET
  META_CSV
  MANUAL
}

enum ChatRoomType {
  DIRECT
  GROUP
}

enum BudgetCategory {
  SHOOT_PRODUCTION
  EQUIPMENT
  ADS_BUDGET
  EVENT
  OTHER
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String
  passwordHash     String
  role             UserRole        @default(MEMBER)
  departmentScope  DepartmentScope @default(CONTENT)
  employmentType   EmploymentType  @default(FULL_TIME)
  title            String          @default("Nhân viên Marketing")
  avatarColor      String          @default("#2563eb")
  pirateCharacter  String?
  preferredTone    String          @default("PIRATE")
  preferredIcon    String?
  personalMotto    String?
  birthDate        String?
  weeklyImageLimit Int?
  dailyVideoLimit  Int?
  dailyKpiJson     Json?
  lastKpiSyncDate  String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  projectMemberships     ProjectMember[]
  assignedTasks          Task[]                  @relation("TaskAssignee")
  requestedTasks         Task[]                  @relation("TaskRequester")
  reviewedTasks          Task[]                  @relation("TaskReviewer")
  deletedTasks           Task[]                  @relation("TaskDeleter")
  timelineSubmittedTasks Task[]                  @relation("TaskTimelineSubmitter")
  assetLinks             AssetLink[]
  comments               TaskComment[]
  checkins               DailyCheckin[]
  notifications          Notification[]
  weeklyReportNotes      WeeklyReportNote[]
  requestedBudgets       BudgetRequest[]         @relation("BudgetRequester")
  reviewedBudgets        BudgetRequest[]         @relation("BudgetReviewer")
  createdChatRooms       ChatRoom[]              @relation("ChatRoomCreator")
  chatMemberships        ChatParticipant[]
  chatMessages           ChatMessage[]           @relation("ChatMessageSender")
  pushSubscriptions      PushSubscription[]
  activityLogs           ActivityLog[]           @relation("ActivityActor")
  quotes                 MotivationalQuote[]     @relation("QuoteAuthor")
  leaveRequests          LeaveRequest[]          @relation("LeaveUser")
  reviewedLeaves         LeaveRequest[]          @relation("LeaveReviewer")
  equipmentBookings      EquipmentBooking[]
  updatedResources       WorkspaceResource[]
  managedFanpages        FanpageChannel[]        @relation("FanpageManager")
  syncedSnapshots        FanpageMetricSnapshot[] @relation("SnapshotSyncer")
  organizedMeetings      TeamMeeting[]            @relation("MeetingOrganizer")
  meetingInvites         TeamMeetingParticipant[]
  qcStandardDocs         QcStandardDoc[]          @relation("QcStandardUpdater")
  authoredCourses        KnowledgeCourse[]        @relation("KnowledgeCourseAuthor")
  lessonProgresses       KnowledgeLessonProgress[] @relation("KnowledgeProgressUser")
}

model Project {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String?
  channelSummary     String?
  weeklySocialTarget Int      @default(0)
  weeklyAdsTarget    Int      @default(0)
  weeklyVideoTarget  Int      @default(0)
  weeklyImageTarget  Int       @default(0)
  kpiNote            String?
  color              String    @default("#2563eb")
  campaignStartAt    DateTime?
  campaignEndAt      DateTime?
  campaignWeeks      Int       @default(4)
  contentPillarsJson Json?
  overviewJson       Json?
  contentMatrixJson  Json?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members           ProjectMember[]
  tasks             Task[]
  weeklyReportNotes WeeklyReportNote[]
  budgetRequests    BudgetRequest[]
  resources         WorkspaceResource[]
  equipmentBookings EquipmentBooking[]
  fanpages          FanpageChannel[]
  meetings          TeamMeeting[]
  qcStandardDocs    QcStandardDoc[]
  knowledgeCourses  KnowledgeCourse[]
}

model ProjectMember {
  id        String             @id @default(cuid())
  projectId String
  userId    String
  scope     ProjectMemberScope @default(PROJECT_WIDE)
  roleLabel String?
  createdAt DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id                   String       @id @default(cuid())
  code                 String       @unique
  title                String
  description          String?
  caption              String?
  platform             String       @default("Fanpage")
  publishChannel       String?
  taskType             TaskType     @default(CONTENT_SOCIAL)
  status               TaskStatus   @default(DRAFT)
  priority             TaskPriority @default(NORMAL)
  isMediaOrder         Boolean      @default(false)
  quantity             Int          @default(1)
  isRushOrder          Boolean      @default(false)
  isOutsideDepartment  Boolean      @default(false)
  revisionCount        Int          @default(0)
  maxRevisions         Int          @default(3)
  scheduledPublishAt   DateTime?
  dueAt                DateTime?
  submittedAt          DateTime?
  approvedAt           DateTime?
  completedAt          DateTime?
  wasLate               Boolean        @default(false)
  qcChecklistJson       Json?
  subtasksJson          Json?
  mediaBriefItemsJson   Json?
  contentPillar         String?
  campaignWeek          Int?
  contentAngle          String?
  postFormat            String?
  mediaDueAt            DateTime?
  productLink           String?
  isAired               Boolean        @default(false)
  matrixIdeaId          String?
  fbPostLayout          String         @default("SINGLE_SQUARE")
  proposedBriefDueAt    DateTime?
  proposedPublishAt     DateTime?
  timelineNote          String?
  timelineStatus        TimelineStatus @default(SYNCED)
  timelineSubmittedAt   DateTime?
  timelineSubmittedById String?
  externalSenderName    String?
  externalDepartment    String?
  externalContact       String?
  dailyKpiKey           String?
  lastAiQcJson          Json?
  lastAiQcAt            DateTime?
  deletedAt             DateTime?
  deletedById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  projectId   String
  assigneeId  String?
  requesterId String
  reviewerId  String?

  project             Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee            User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requester           User    @relation("TaskRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer            User?   @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  deletedBy           User?   @relation("TaskDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  timelineSubmittedBy User?   @relation("TaskTimelineSubmitter", fields: [timelineSubmittedById], references: [id], onDelete: SetNull)

  assets       AssetLink[]
  comments     TaskComment[]
  checkins     DailyCheckin[]
  activityLogs ActivityLog[]

  @@index([projectId, status])
  @@index([deletedAt, projectId, status])
  @@index([assigneeId, dueAt])
  @@index([status, dueAt])
}

model AssetLink {
  id          String    @id @default(cuid())
  taskId      String
  kind        AssetKind @default(DEMO)
  label       String
  url         String
  version     Int       @default(1)
  createdById String
  createdAt   DateTime  @default(now())

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([taskId, kind])
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  authorId    String
  content     String
  qcFlagsJson Json?
  createdAt   DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model DailyCheckin {
  id          String        @id @default(cuid())
  userId      String
  taskId      String?
  checkinDate String
  status      CheckinStatus @default(ON_TRACK)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([checkinDate, userId])
}

model WeeklyReportNote {
  id         String   @id @default(cuid())
  projectId  String
  authorId   String
  weekStart  String
  highlights String?
  blockers   String?
  proposals  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([projectId, weekStart])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType @default(SYSTEM)
  title      String
  message    String
  linkUrl    String?
  isRead     Boolean          @default(false)
  emailSent  Boolean          @default(false)
  emailError String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model CronRunLog {
  id                   String   @id @default(cuid())
  slot                 String
  runDate              String
  emailsSent           Int      @default(0)
  notificationsCreated Int      @default(0)
  summary              String?
  createdAt            DateTime @default(now())

  @@unique([slot, runDate])
}

model BudgetRequest {
  id          String         @id @default(cuid())
  code        String         @unique
  title       String
  category    BudgetCategory @default(SHOOT_PRODUCTION)
  amount      Int
  neededBy    DateTime?
  note        String?
  status      BudgetStatus   @default(PENDING)
  reviewNote  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  projectId   String
  requesterId String
  reviewerId  String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester User    @relation("BudgetRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User?   @relation("BudgetReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model ChatRoom {
  id             String       @id @default(cuid())
  type           ChatRoomType @default(GROUP)
  name           String?
  description    String?
  allowAnonymous Boolean      @default(true)
  isPinned       Boolean      @default(false)
  createdById    String
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy    User              @relation("ChatRoomCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([type, lastMessageAt])
}

model ChatParticipant {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  isAdmin    Boolean  @default(false)
  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, lastReadAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  roomId         String
  senderId       String
  content        String
  isAnonymous    Boolean  @default(false)
  anonymousAlias String?
  attachmentUrl  String?
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MotivationalQuote {
  id          String   @id @default(cuid())
  content     String
  authorLabel String   @default("Thuyền trưởng")
  tone        String   @default("ALL")
  isPinned    Boolean  @default(false)
  likes       Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation("QuoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isPinned, createdAt])
}

model ActivityLog {
  id          String             @id @default(cuid())
  entityType  ActivityEntityType @default(TASK)
  entityId    String
  taskId      String?
  actorId     String?
  action      ActivityAction     @default(UPDATE)
  summary     String
  changesJson Json?
  createdAt   DateTime           @default(now())

  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  leaveType    LeaveType   @default(FULL_DAY)
  startDate    String
  endDate      String
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User  @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([startDate, endDate, status])
  @@index([userId, startDate])
}

model EquipmentItem {
  id          String             @id @default(cuid())
  name        String
  category    EquipmentCategory  @default(CAMERA)
  code        String             @unique
  description String?
  status      EquipmentCondition @default(AVAILABLE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  bookings EquipmentBooking[]
}

model EquipmentBooking {
  id          String        @id @default(cuid())
  equipmentId String
  userId      String
  projectId   String?
  purpose     String
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(BOOKED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  equipment EquipmentItem @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([equipmentId, startAt, endAt, status])
  @@index([userId, startAt])
}

model WorkspaceResource {
  id          String           @id @default(cuid())
  scope       ResourceScope    @default(PROJECT)
  projectId   String?
  category    ResourceCategory @default(OTHER)
  title       String
  url         String
  description String?
  tags        String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([scope, projectId, category])
}

model FanpageChannel {
  id             String   @id @default(cuid())
  name           String
  pageId         String?
  pageUrl        String
  accessToken    String?
  projectId      String?
  managedById    String?
  followers      Int      @default(0)
  likesCount     Int      @default(0)
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncNote   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project   Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  managedBy User?                   @relation("FanpageManager", fields: [managedById], references: [id], onDelete: SetNull)
  snapshots FanpageMetricSnapshot[]

  @@index([projectId, isActive])
}

model FanpageMetricSnapshot {
  id                String            @id @default(cuid())
  channelId         String
  capturedAt        DateTime          @default(now())
  weekStart         String
  monthKey          String
  followers         Int               @default(0)
  followersDelta    Int               @default(0)
  newFollowers      Int               @default(0)
  unfollows         Int               @default(0)
  reach             Int               @default(0)
  impressions       Int               @default(0)
  pageViews         Int               @default(0)
  videoViews        Int               @default(0)
  linkClicks        Int               @default(0)
  inboxMessages     Int               @default(0)
  engagement        Int               @default(0)
  engagementRate    Float             @default(0)
  reactions         Int               @default(0)
  comments          Int               @default(0)
  shares            Int               @default(0)
  postsCount        Int               @default(0)
  topPostTitle      String?
  topPostUrl        String?
  topPostReach      Int               @default(0)
  topPostEngagement Int               @default(0)
  topPostsJson      Json?
  source            FanpageSyncSource @default(PUBLIC_SCRAPE)
  sentToLeaderAt    DateTime?
  syncedById        String?
  notes             String?

  channel  FanpageChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  syncedBy User?          @relation("SnapshotSyncer", fields: [syncedById], references: [id], onDelete: SetNull)

  @@index([channelId, capturedAt])
  @@index([weekStart, channelId])
  @@index([monthKey, channelId])
}

model TeamMeeting {
  id          String   @id @default(cuid())
  title       String
  agenda      String?
  location    String?
  meetingType String   @default("SYNC")
  startAt     DateTime
  endAt       DateTime
  projectId   String?
  organizerId String
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizer    User                     @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  participants TeamMeetingParticipant[]

  @@index([startAt, status])
}

model TeamMeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  rsvp      String   @default("INVITED")
  createdAt DateTime @default(now())

  meeting TeamMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

model QcStandardDoc {
  id             String   @id @default(cuid())
  title          String
  category       String   @default("ALL")
  sourceType     String   @default("TEXT")
  contentText    String?
  sourceUrl      String?
  fileName       String?
  mimeType       String?
  fileDataBase64 String?
  isActive       Boolean  @default(true)
  projectId      String?
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  updatedBy User     @relation("QcStandardUpdater", fields: [updatedById], references: [id], onDelete: Cascade)

  @@index([isActive, category, projectId])
}

model KnowledgeCourse {
  id               String           @id @default(cuid())
  title            String
  description      String?
  courseUrl        String
  trackType        String           @default("OFFICIAL")
  category         String           @default("GENERAL")
  targetDepartment DepartmentScope?
  isMandatory      Boolean          @default(false)
  isPinned         Boolean          @default(false)
  estimatedMinutes Int              @default(30)
  projectId        String?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project    Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User                      @relation("KnowledgeCourseAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  lessons    KnowledgeLesson[]
  progresses KnowledgeLessonProgress[]

  @@index([trackType, category, isMandatory])
  @@index([createdById])
}

model KnowledgeLesson {
  id              String   @id @default(cuid())
  courseId        String
  orderIndex      Int      @default(0)
  title           String
  lessonUrl       String?
  summary         String?
  durationMinutes Int      @default(15)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course     KnowledgeCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses KnowledgeLessonProgress[]

  @@index([courseId, orderIndex])
}

model KnowledgeLessonProgress {
  id          String    @id @default(cuid())
  courseId    String
  lessonId    String
  userId      String
  status      String    @default("NOT_STARTED")
  takeaways   String?
  practiceUrl String?
  leaderNote  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course KnowledgeCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson KnowledgeLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User            @relation("KnowledgeProgressUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId, status])
  @@index([courseId, userId])
}
