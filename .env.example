# Database PostgreSQL (Neon Free trên Vercel Storage hoặc `npx prisma dev` khi chạy local)
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Khóa bí mật ký cookie đăng nhập (đặt chuỗi ngẫu nhiên dài >= 32 ký tự khi deploy Vercel)
AUTH_SECRET="meta-ecom-mkt-internal-secret-change-in-production-2026"

# Khóa bảo mật cho API nhắc lịch Cron (/api/cron/reminders)
CRON_SECRET="meta-ecom-cron-secret-change-in-production-2026"

# Email thông báo qua Gmail của Team MKT (Tạo App Password 16 ký tự trong Google Account -> Security -> App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Meta Ecom MKT Hub"

# Link web chính thức sau khi deploy Vercel (dùng để gắn link bấm mở trực tiếp trong Email)
APP_URL="http://localhost:3000"

# Google Gemini API (dùng cho tính năng AI Check QC Output — có thể nhập trực tiếp ở UI bởi Leader hoặc đặt ở đây)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
